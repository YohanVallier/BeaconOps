# BeaconOps — Example environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# NEVER commit a real `.env` file containing secrets to version control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Runtime environment: development | test | production
BEACONOPS_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
BEACONOPS_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLAlchemy database URL.
# Local development (SQLite):
BEACONOPS_DATABASE_URL=sqlite:///./beaconops.db
# Production example (PostgreSQL):
# BEACONOPS_DATABASE_URL=postgresql+psycopg://beaconops:CHANGE_ME@localhost:5432/beaconops

# ---------------------------------------------------------------------------
# HTTP client / monitoring
# ---------------------------------------------------------------------------
# Default timeout (seconds) applied to outbound monitoring requests.
BEACONOPS_HTTP_TIMEOUT_SECONDS=10

# Maximum response body size (bytes) read from monitored endpoints.
BEACONOPS_HTTP_MAX_RESPONSE_BYTES=1048576

# Maximum number of concurrent monitor checks executed by the scheduler.
BEACONOPS_MAX_CONCURRENT_CHECKS=10

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# Enable the background scheduler (true | false).
BEACONOPS_SCHEDULER_ENABLED=true

# Default interval (seconds) between checks for monitors without an override.
BEACONOPS_DEFAULT_CHECK_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Incident detection
# ---------------------------------------------------------------------------
# Number of consecutive failures required to open an incident.
BEACONOPS_FAILURE_THRESHOLD=3

# Number of consecutive successes required to close an incident.
BEACONOPS_RECOVERY_THRESHOLD=2

# ---------------------------------------------------------------------------
# Notifications (Webhook)
# ---------------------------------------------------------------------------
# Enable outbound webhook notifications (true | false).
BEACONOPS_NOTIFICATIONS_ENABLED=true

# Default webhook URL used when a monitor does not define its own.
# Leave empty to disable the global default.
BEACONOPS_DEFAULT_WEBHOOK_URL=

# Timeout (seconds) for webhook delivery requests.
BEACONOPS_WEBHOOK_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Security / SSRF protection
# ---------------------------------------------------------------------------
# Allow monitoring of private, loopback, link-local and reserved IP ranges.
# Keep this `false` in production unless you fully understand the risk.
BEACONOPS_ALLOW_PRIVATE_TARGETS=false

# Comma-separated list of additional hostnames explicitly allowed
# (e.g. internal services you trust). Empty by default.
BEACONOPS_ALLOWED_HOSTS=

# Comma-separated list of ports permitted for monitored endpoints.
# Empty means "any port" (subject to the other SSRF checks).
BEACONOPS_ALLOWED_PORTS=80,443

# Maximum number of HTTP redirects followed during a check.
BEACONOPS_MAX_REDIRECTS=3

# ---------------------------------------------------------------------------
# API security
# ---------------------------------------------------------------------------
# API key required for administrative endpoints.
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
BEACONOPS_ADMIN_API_KEY=

# ---------------------------------------------------------------------------
# Server (Uvicorn)
# ---------------------------------------------------------------------------
BEACONOPS_HOST=0.0.0.0
BEACONOPS_PORT=8000
BEACONOPS_RELOAD=false